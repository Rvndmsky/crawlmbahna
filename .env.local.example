# Konfigurasi AI bisa diatur lewat halaman ⚙ Setup di website (disimpan ke
# data/settings.json). Nilai di bawah ini cuma DEFAULT AWAL kalau belum diatur.

# --- Pilih salah satu provider ---

# Opsi A: Anthropic (Claude) — web search bawaan, paling akurat
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# Opsi B: OpenRouter (bebas pilih model, web live via plugin)
OPENROUTER_API_KEY=
# OPENAI_BASE_URL=https://openrouter.ai/api/v1

# Opsi C: OpenAI-compatible lain
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- Login (akses terbatas) ---
AUTH_EMAIL=pejaten@mbahrazu.com
AUTH_PASSWORD=pejatenkeren

# Cache hasil pencarian (menit).
SEARCH_CACHE_MINUTES=180

# --- Pantau individu (/gettargetmbahna) ---
# Daftar nama target default (pisah koma). Dipakai kalau data/targets.json belum
# ada — wajib di Vercel karena filesystem read-only.
TARGET_NAMES=
# Cache hasil sisir sosmed per target (menit).
TARGET_CACHE_MINUTES=60

# --- Konektor platform (opsional; kosongkan = di-skip) ---
YOUTUBE_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
TG_API_ID=
TG_API_HASH=
TG_SESSION=

# --- Worker Facebook (worker/fb-worker.mjs) ---
# Token bersama antara website dan worker. Kosong = endpoint /api/fb/ingest
# TERTUTUP (worker tidak bisa mengirim apa pun). Isi string acak panjang.
FB_WORKER_TOKEN=

# --- Penyimpanan hasil worker Facebook ---
# WAJIB di Vercel: tanpa ini data ditulis ke /tmp yang ephemeral (bisa hilang,
# tidak terbaca instance lain). Gratis di upstash.com -> Create Database ->
# salin dua nilai di tab "REST API".
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Model per bagian (opsional) ---
# Kosong = ikut AI_MODEL. Isi kalau satu bagian butuh model berbeda, mis.
# dashboard pakai model cepat berpencarian, infografis pakai model penyusun
# teks yang lebih rapi.
AI_MODEL_DASHBOARD=
AI_MODEL_SEARCH=
AI_MODEL_TARGET=
AI_MODEL_DOSSIER=
AI_MODEL_INFOGRAFIS=

# --- Ilustrasi infografis ---
# Model gambar untuk pita header /infografis. Teks & angka TIDAK pernah dibuat
# model ini — hanya ilustrasinya. Setel false untuk mematikan.
AI_IMAGE_MODEL=google/gemini-3.1-flash-image
INFOGRAFIS_ILUSTRASI=true

# --- Pemeriksaan akhir infografis ---
# Model PENGLIHATAN yang memeriksa gambar jadinya: teks terpotong, tumpang
# tindih, ukuran, dan salah ketik. Setel false untuk mematikan.
AI_MODEL_PERIKSA=google/gemini-2.5-flash
INFOGRAFIS_PERIKSA=true
