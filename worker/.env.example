# Alamat website tujuan kiriman hasil crawl.
# Lokal: http://localhost:3000 | Produksi: https://<domain-vercel-mu>
APP_URL=http://localhost:3000

# --- Akun Facebook ---
# Cara aman (disarankan): kosongkan dua baris ini, jalankan `npm run login`
# sekali. Sandi tidak tersimpan, cuma cookie sesi di worker/fb-profile/.
#
# Cara praktis: isi email + sandi. Dipakai HANYA kalau sesi cookie mati.
# Risiko: Facebook agresif menandai login skrip (checkpoint), 2FA tidak bisa
# dilewati, dan sandi tersimpan plaintext di berkas ini.
FB_EMAIL=
FB_PASSWORD=

# Harus SAMA dengan FB_WORKER_TOKEN di server. Kosong = hasil hanya ditulis
# ke data/fb-inbox.json, tidak dikirim ke website.
FB_WORKER_TOKEN=

# Tema utama pemantauan Facebook — disisir apa adanya, tanpa nama target.
FB_THEMES=demo,unjuk rasa,demo indonesia,prabowo demo,prabowo lengser,demo mahasiswa,aksi massa

# Kata kunci isu yang digabung dengan tiap nama target.
FB_KEYWORDS=demo,unjuk rasa,aksi massa

# Kueri manual (pisah koma). Kalau diisi, daftar target diabaikan.
FB_QUERIES=

# Buka tiap post untuk ambil isi penuh + komentar teratas (paling banyak like).
# Ini bagian paling lambat: satu kunjungan halaman per post.
FB_FETCH_COMMENTS=true
FB_DETAIL_PER_QUERY=5
FB_COMMENTS_PER_POST=8

# Batas kesegaran: post lebih tua dari ini dibuang (hari).
FB_MAX_AGE_DAYS=3

# Tangkapan layar tiap post yang dibuka (JPEG). Matikan kalau ingin ringan.
FB_SCREENSHOT=true

# Perilaku crawl.
FB_HEADLESS=true
FB_MAX_SCROLL=4
FB_DELAY_MS=4000
FB_PER_QUERY=12
FB_MAX_QUERIES=12
FB_LOOP_MINUTES=60

# Berapa akun yang dibaca jumlah pengikutnya tiap putaran (mode --akun).
AKUN_PER_PUTARAN=12
